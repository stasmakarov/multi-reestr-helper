<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://checkResultDialog.title"
      focusComponent="resultsDataGrid">
    <data>
        <collection id="resultsDc" class="com.digitilius.multireestr.entity.legacy.CheckResultDto"/>
    </data>
    <actions>
        <action id="closeAction" type="view_close"/>
    </actions>
    <layout>
        <span id="emptyHint" text="msg://checkResultDialog.empty" visible="false"/>
        <dataGrid id="resultsDataGrid"
                  dataContainer="resultsDc"
                  width="100%"
                  minHeight="16em"
                  columnReorderingAllowed="true">
            <columns resizable="true">
                <column property="severity" autoWidth="true"/>
                <column property="ruleCode" autoWidth="true"/>
                <column property="ruleName" autoWidth="true"/>
                <column property="detail" flexGrow="1"/>
                <column property="message" flexGrow="1"/>
                <column property="legalRef" flexGrow="1"/>
            </columns>
        </dataGrid>
        <span id="selectHint" text="msg://checkResultDialog.hit.select" visible="false"/>
        <formLayout id="hitDetails" width="100%" classNames="check-hit-details" visible="false">
            <textField id="ruleField" readOnly="true" width="100%"
                       label="msg://checkResultDialog.hit.rule"/>
            <textField id="severityField" readOnly="true" width="100%"
                       label="msg://checkResultDialog.hit.severity"/>
            <textArea id="messageField" readOnly="true" width="100%" colspan="2" height="6em"
                      classNames="check-hit-text"
                      label="msg://checkResultDialog.hit.message"/>
            <textArea id="detailField" readOnly="true" width="100%" colspan="2" height="5em"
                      classNames="check-hit-text"
                      label="msg://checkResultDialog.hit.detail"/>
            <textArea id="legalRefField" readOnly="true" width="100%" colspan="2" height="4em"
                      classNames="check-hit-text"
                      label="msg://checkResultDialog.hit.legalRef"/>
        </formLayout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="saveButton" text="msg://checkResultDialog.save"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
