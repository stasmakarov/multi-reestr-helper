<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://planScheduleEventDetailView.title"
      focusComponent="form">
    <data>
        <instance id="planScheduleEventDc" class="com.digitilius.multireestr.entity.PlanScheduleEvent">
            <fetchPlan extends="_base"/>
            <loader id="planScheduleEventDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="planScheduleEventDc">
            <comboBox id="planScheduleHintField" label="msg://planScheduleHint.label" colspan="2"/>
            <integerField id="finYearField" property="finYear"/>
            <integerField id="planVersionField" property="planVersion"/>
            <integerField id="legacyPlanIdField" property="legacyPlanId"/>
            <datePicker id="lboDateField" property="lboDate"/>
            <datePicker id="approvalDateField" property="approvalDate"/>
            <textField id="basisDocumentField" property="basisDocument" colspan="2"/>
            <textArea id="noteField" property="note" colspan="2" height="6em"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
