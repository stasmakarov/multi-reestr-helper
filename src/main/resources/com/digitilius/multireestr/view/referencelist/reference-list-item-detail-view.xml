<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://referenceListItemDetailView.title"
      focusComponent="form">
    <data>
        <instance id="referenceListItemDc" class="com.digitilius.multireestr.entity.ReferenceListItem">
            <fetchPlan extends="_base">
                <property name="list" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="referenceListItemDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="referenceListItemDc">
            <textField id="valueField" property="value"/>
            <checkbox id="prefixMatchField" property="prefixMatch"/>
            <checkbox id="excludedField" property="excluded"/>
            <textField id="groupCodeField" property="groupCode"/>
            <textField id="captionField" property="caption" colspan="2"/>
            <datePicker id="validFromField" property="validFrom"/>
            <datePicker id="validToField" property="validTo"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
