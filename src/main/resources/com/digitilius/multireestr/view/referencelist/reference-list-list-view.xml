<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://referenceListListView.title"
      focusComponent="referenceListsDataGrid">
    <data>
        <collection id="referenceListsDc" class="com.digitilius.multireestr.entity.ReferenceList">
            <fetchPlan extends="_base"/>
            <loader id="referenceListsDl" readOnly="true">
                <query>
                    <![CDATA[select e from mtr_ReferenceList e order by e.code]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter" dataLoader="referenceListsDl">
            <properties include="kind|code|name|legalRef"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="referenceListsDataGrid.createAction"/>
                <button id="editButton" action="referenceListsDataGrid.editAction"/>
                <button id="removeButton" action="referenceListsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="referenceListsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="referenceListsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="referenceListsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="code"/>
                <column property="name"/>
                <column property="kind"/>
                <column property="legalRef"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
