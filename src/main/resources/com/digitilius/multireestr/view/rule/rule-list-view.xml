<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ruleListView.title"
      focusComponent="rulesDataGrid">
    <data>
        <collection id="rulesDc" class="com.digitilius.multireestr.entity.Rule">
            <fetchPlan extends="_base"/>
            <loader id="rulesDl" readOnly="true">
                <query>
                    <![CDATA[select e from mtr_Rule e order by e.code]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter" dataLoader="rulesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="rulesDataGrid.createAction"/>
                <button id="editButton" action="rulesDataGrid.editAction"/>
                <button id="removeButton" action="rulesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="rulesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="rulesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="rulesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="code"/>
                <column property="name"/>
                <column property="templateType"/>
                <column property="objectType"/>
                <column property="severity"/>
                <column property="enabled"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
