<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://calendarDayDetailView.title"
      focusComponent="form">
    <data>
        <instance id="calendarDayDc" class="com.digitilius.multireestr.entity.CalendarDay">
            <fetchPlan extends="_base"/>
            <loader id="calendarDayDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="calendarDayDc">
            <datePicker id="dateField" property="date"/>
            <integerField id="yearField" property="year"/>
            <comboBox id="dayTypeField" property="dayType"/>
            <comboBox id="sourceField" property="source"/>
            <textField id="markField" property="mark"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
