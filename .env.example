# Copy to .env and fill in. Do not commit .env.
# Legacy MultiReestr host/port/user/password are NOT set here — use the admin UI
# («Подключение к MultiReestr») after the app starts.

# 64 hex characters. Encrypts the MultiReestr password stored in the main DB.
# Example generation: openssl rand -hex 32
MTR_SECRET_KEY=

# Jmix main database (compose service postgres, PostgreSQL 16, host port 5435)
POSTGRES_DB=multireestr
POSTGRES_USER=multireestr
POSTGRES_PASSWORD=
